# CPaT-only additions to the Microsoft Windows Dev Config Full baseline.
# Run .\install.ps1; applying this file alone does not install the baseline.
# Microsoft owns core tools, OS settings, fonts, Terminal, Oh My Posh, and WSL.

$schema: https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/2023/08/config/document.json
metadata:
  winget:
    processor:
      identifier: dscv3
resources:
- type: Microsoft.Windows/Registry
  name: GitCodeFolders
  properties:
    keyPath: HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\Advanced
    valueName: NavPaneShowVersionControl
    valueData:
      DWord: 1
  metadata:
    description: Enable Git integration in File Explorer
    securityContext: elevated
- type: Microsoft.WinGet/Package
  name: TortoiseGit
  properties:
    id: TortoiseGit.TortoiseGit
    source: winget
    useLatest: true
    installMode: silent
    acceptAgreements: true
  metadata:
    description: Install TortoiseGit
    securityContext: elevated
- type: Microsoft.DSC.Transitional/PowerShellScript
  name: VSCodeExplorerContextMenus
  properties:
    getScript: |
      $isClassicForced = Test-Path 'HKCU:\Software\Classes\CLSID\{86ca1aa0-34aa-4e8b-a509-50c905bae2a2}\InprocServer32'
      $appx = Get-AppxPackage -Name 'Microsoft.VisualStudioCode' -ErrorAction SilentlyContinue
      $title = Get-ItemPropertyValue -Path 'HKCU:\Software\Classes\VSCodeContextMenu' -Name 'Title' -ErrorAction SilentlyContinue
      return @{
        classicMenuForced = $isClassicForced
        appxInstalled = [bool]$appx
        title = $title
        configured = ($isClassicForced -or ([bool]$appx -and [string]::IsNullOrWhiteSpace($title) -eq $false))
      }
    testScript: |
      $isClassicForced = Test-Path 'HKCU:\Software\Classes\CLSID\{86ca1aa0-34aa-4e8b-a509-50c905bae2a2}\InprocServer32'
      if ($isClassicForced) { return $true }

      $appx = Get-AppxPackage -Name 'Microsoft.VisualStudioCode' -ErrorAction SilentlyContinue
      $title = Get-ItemPropertyValue -Path 'HKCU:\Software\Classes\VSCodeContextMenu' -Name 'Title' -ErrorAction SilentlyContinue
      return ([bool]$appx -and [string]::IsNullOrWhiteSpace($title) -eq $false)
    setScript: |
      $ErrorActionPreference = 'Stop'

      $isClassicForced = Test-Path 'HKCU:\Software\Classes\CLSID\{86ca1aa0-34aa-4e8b-a509-50c905bae2a2}\InprocServer32'
      if ($isClassicForced) { return }

      @(
        'HKCU:\Software\Classes\*\shell\VSCode',
        'HKCU:\Software\Classes\Directory\shell\VSCode',
        'HKCU:\Software\Classes\Directory\Background\shell\VSCode',
        'HKCU:\Software\Classes\Drive\shell\VSCode'
      ) | ForEach-Object {
        if (Test-Path $_) {
          Remove-Item -Path $_ -Recurse -Force
        }
      }

      $paths = @(
        "$env:LOCALAPPDATA\Programs\Microsoft VS Code\Code.exe",
        "$env:ProgramFiles\Microsoft VS Code\Code.exe",
        "${env:ProgramFiles(x86)}\Microsoft VS Code\Code.exe"
      ) | Where-Object { $_ -and (Test-Path $_) }
      $codeExe = $paths | Select-Object -First 1
      if (-not $codeExe) { throw 'VS Code executable was not found after VSCode package installation.' }

      $installRoot = Split-Path $codeExe -Parent
      $appxFile = Get-ChildItem -Path $installRoot -Recurse -Filter 'code_*.appx' -ErrorAction SilentlyContinue |
        Sort-Object LastWriteTime -Descending |
        Select-Object -First 1
      if (-not $appxFile) {
        throw "VS Code Explorer AppX package was not found under '$installRoot'."
      }

      $appxInstalled = Get-AppxPackage -Name 'Microsoft.VisualStudioCode' -ErrorAction SilentlyContinue
      if (-not $appxInstalled) {
        Add-AppxPackage -Path $appxFile.FullName -ExternalLocation $appxFile.DirectoryName
      }

      New-Item -Path 'HKCU:\Software\Classes\VSCodeContextMenu' -Force | Out-Null
      Set-ItemProperty -Path 'HKCU:\Software\Classes\VSCodeContextMenu' -Name 'Title' -Type ExpandString -Value 'Open w&ith Code'

      $verifyAppx = Get-AppxPackage -Name 'Microsoft.VisualStudioCode' -ErrorAction SilentlyContinue
      $verifyTitle = Get-ItemPropertyValue -Path 'HKCU:\Software\Classes\VSCodeContextMenu' -Name 'Title' -ErrorAction SilentlyContinue
      if (-not $verifyAppx -or [string]::IsNullOrWhiteSpace($verifyTitle)) {
        throw 'VS Code Windows 11 context menu registration is incomplete.'
      }
  metadata:
    description: Ensure VS Code Windows 11 context menu registration is applied
- type: Microsoft.DSC.Transitional/PowerShellScript
  name: VSCodeExtensions
  properties:
    getScript: |
      $extensionIds = @(
        'github.vscode-pull-request-github',
        'microsoft-aspire.aspire-vscode',
        'ms-azuretools.vscode-containers',
        'ms-dotnettools.csdevkit',
        'ms-dotnettools.csharp',
        'ms-dotnettools.vscode-dotnet-runtime',
        'ms-playwright.playwright',
        'ms-vscode-remote.remote-containers'
      )

      $codeExe = @(
        "$env:LOCALAPPDATA\Programs\Microsoft VS Code\bin\code.cmd",
        "$env:ProgramFiles\Microsoft VS Code\bin\code.cmd",
        "${env:ProgramFiles(x86)}\Microsoft VS Code\bin\code.cmd"
      ) | Where-Object { $_ -and (Test-Path $_) } | Select-Object -First 1

      if (-not $codeExe) {
        return @{ cliPresent = $false; missing = $extensionIds }
      }

      $installed = @(& $codeExe --list-extensions 2>$null | ForEach-Object { $_.Trim().ToLowerInvariant() })
      $missing = @($extensionIds | Where-Object { $installed -notcontains $_ })
      return @{ cliPresent = $true; missing = $missing }
    testScript: |
      $extensionIds = @(
        'github.vscode-pull-request-github',
        'microsoft-aspire.aspire-vscode',
        'ms-azuretools.vscode-containers',
        'ms-dotnettools.csdevkit',
        'ms-dotnettools.csharp',
        'ms-dotnettools.vscode-dotnet-runtime',
        'ms-playwright.playwright',
        'ms-vscode-remote.remote-containers'
      )

      $codeExe = @(
        "$env:LOCALAPPDATA\Programs\Microsoft VS Code\bin\code.cmd",
        "$env:ProgramFiles\Microsoft VS Code\bin\code.cmd",
        "${env:ProgramFiles(x86)}\Microsoft VS Code\bin\code.cmd"
      ) | Where-Object { $_ -and (Test-Path $_) } | Select-Object -First 1

      if (-not $codeExe) { return $false }

      $installed = @(& $codeExe --list-extensions 2>$null | ForEach-Object { $_.Trim().ToLowerInvariant() })
      return (@($extensionIds | Where-Object { $installed -notcontains $_ }).Count -eq 0)
    setScript: |
      $ErrorActionPreference = 'Stop'

      $extensionIds = @(
        'github.vscode-pull-request-github',
        'microsoft-aspire.aspire-vscode',
        'ms-azuretools.vscode-containers',
        'ms-dotnettools.csdevkit',
        'ms-dotnettools.csharp',
        'ms-dotnettools.vscode-dotnet-runtime',
        'ms-playwright.playwright',
        'ms-vscode-remote.remote-containers'
      )

      $codeExe = @(
        "$env:LOCALAPPDATA\Programs\Microsoft VS Code\bin\code.cmd",
        "$env:ProgramFiles\Microsoft VS Code\bin\code.cmd",
        "${env:ProgramFiles(x86)}\Microsoft VS Code\bin\code.cmd"
      ) | Where-Object { $_ -and (Test-Path $_) } | Select-Object -First 1

      if (-not $codeExe) {
        throw 'VS Code CLI (code.cmd) was not found after VSCode package installation.'
      }

      $failed = @()
      foreach ($extensionId in $extensionIds) {
        & $codeExe --install-extension $extensionId --force
        if ($LASTEXITCODE -ne 0) {
          $failed += "$extensionId (exit code $LASTEXITCODE)"
        }
      }

      if ($failed.Count -gt 0) {
        throw "Failed to install VS Code extension(s): $($failed -join ', ')."
      }
  metadata:
    description: Install the baseline VS Code extensions
- type: Microsoft.WinGet/Package
  name: Aspire
  properties:
    id: Microsoft.Aspire
    source: winget
    useLatest: true
    installMode: silent
    acceptAgreements: true
  metadata:
