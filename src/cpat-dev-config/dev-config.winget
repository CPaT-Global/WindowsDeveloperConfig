- type: Microsoft.WinGet/Package
  name: Bun
  properties:
    id: Oven-sh.Bun
    source: winget
    useLatest: true
    installMode: silent
    acceptAgreements: true
  metadata:
    description: Install Bun (JavaScript runtime and package manager)
    securityContext: elevated
- type: Microsoft.DSC.Transitional/PowerShellScript
  name: PlaywrightChromiumBootstrap
  properties:
    getScript: |
      $playwrightCmd = Get-Command playwright -ErrorAction SilentlyContinue
      if (-not $playwrightCmd) {
        $candidate = Join-Path $env:APPDATA 'npm\playwright.cmd'
        if (Test-Path $candidate) {
          $playwrightCmd = Get-Item -LiteralPath $candidate
        }
      }

      $browserRoot = Join-Path $env:LOCALAPPDATA 'ms-playwright'
      $hasChromium = [bool](Get-ChildItem -Path $browserRoot -Directory -Filter 'chromium-*' -ErrorAction SilentlyContinue | Select-Object -First 1)
      return @{ cliPresent = [bool]$playwrightCmd; chromiumInstalled = $hasChromium }
    testScript: |
      $playwrightCmd = Get-Command playwright -ErrorAction SilentlyContinue
      if (-not $playwrightCmd) {
        $candidate = Join-Path $env:APPDATA 'npm\playwright.cmd'
        if (Test-Path $candidate) {
          $playwrightCmd = Get-Item -LiteralPath $candidate
        }
      }

      $browserRoot = Join-Path $env:LOCALAPPDATA 'ms-playwright'
      $hasChromium = [bool](Get-ChildItem -Path $browserRoot -Directory -Filter 'chromium-*' -ErrorAction SilentlyContinue | Select-Object -First 1)
      return ([bool]$playwrightCmd -and $hasChromium)
    setScript: |
      $ErrorActionPreference = 'Stop'

      $npm = Get-Command npm -ErrorAction Stop
      & $npm.Source install --global playwright
      if ($LASTEXITCODE -ne 0) {
        throw "Failed to install Playwright npm package (exit code $LASTEXITCODE)."
      }

      $playwrightExe = Join-Path $env:APPDATA 'npm\playwright.cmd'
      if (-not (Test-Path $playwrightExe)) {
        $playwright = Get-Command playwright -ErrorAction SilentlyContinue
        if ($playwright) {
          $playwrightExe = $playwright.Source
        }
      }

      if (-not (Test-Path $playwrightExe)) {
        throw 'Playwright CLI was not found after npm global install.'
      }

      & $playwrightExe install chromium
      if ($LASTEXITCODE -ne 0) {
        throw "Failed to install Playwright Chromium browser (exit code $LASTEXITCODE)."
      }
  metadata:
    description: Install Playwright CLI and Chromium browser
- type: Microsoft.WinGet/Package
  name: Chrome
  properties:
