- type: Microsoft.DSC.Transitional/PowerShellScript
  name: PwshProfileFunctions
  properties:
    getScript: |
      $profilePath = Join-Path ([Environment]::GetFolderPath('MyDocuments')) 'PowerShell\Microsoft.PowerShell_profile.ps1'
      $hasBlock = (Test-Path $profilePath) -and ((Get-Content -LiteralPath $profilePath -Raw) -match '# BEGIN DevConfig helper functions')
      return @{ profilePath = $profilePath; helpersPresent = $hasBlock }
    testScript: |
      $profilePath = Join-Path ([Environment]::GetFolderPath('MyDocuments')) 'PowerShell\Microsoft.PowerShell_profile.ps1'
      return ((Test-Path $profilePath) -and ((Get-Content -LiteralPath $profilePath -Raw) -match '# BEGIN DevConfig helper functions'))
    setScript: |
      $ErrorActionPreference = 'Stop'

      $profilePath = Join-Path ([Environment]::GetFolderPath('MyDocuments')) 'PowerShell\Microsoft.PowerShell_profile.ps1'
      New-Item -ItemType Directory -Path (Split-Path -Parent $profilePath) -Force | Out-Null
      if (-not (Test-Path $profilePath)) {
        New-Item -ItemType File -Path $profilePath -Force | Out-Null
      }

      $block = @'
      # BEGIN DevConfig helper functions
      function ll {
          Get-ChildItem -Force @args
      }
      # END DevConfig helper functions
      '@

      Add-Content -LiteralPath $profilePath -Value "`r`n$block" -Encoding UTF8
      Write-Host "Added helper functions to $profilePath" -ForegroundColor Green
  metadata:
    description: Add helper functions (ll) to the PowerShell 7 profile
